# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private local agent orchestration — never commit
.agent/
*AGENT_MASTER_PROMPT*.md
*PHASE_*_MASTER_PROMPT*.md
*PHASE-*_MASTER_PROMPT*.md

# CLI-generated local agent tooling — never commit
.agents/
.claude/
skills-lock.json

# Phase 2 native/WASM build output (never commit build artifacts).
# Exception: the staged runtime under public/wasm IS committed — the
# deploy/vercel path serves it as a static asset without requiring an
# Emscripten toolchain at deploy time; local `npm run wasm:build`
# still refreshes these exact files from the same C++ source.
build/
wasm/dist/
*.wasm.map
.emcache/
compile_commands.json
!public/wasm/concord-crdt.wasm
!public/wasm/concord-crdt.js

# Phase 3 Rust build output (never commit build artifacts)
rust/**/target/
