{
  "name": "concord",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:realtime": "vitest run --project realtime",
    "test:db": "vitest run --project db",
    "test:all": "npm run test && npm run test:db",
    "test:coverage": "vitest run --project unit --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "smoke": "node scripts/smoke.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:test": "node scripts/db/migrate.mjs --test",
    "db:test:prepare": "node scripts/db/prepare-test-db.mjs",
    "db:studio": "drizzle-kit studio",
    "wasm:build": "node scripts/wasm-build.mjs",
    "worker:bundle": "node scripts/worker-bundle.mjs",
    "wasm:smoke": "node wasm/smoke.mjs",
    "test:browser": "playwright test --project=chromium tests/browser/journey.spec.ts tests/browser/a11y.spec.ts",
    "test:browser:smoke:chromium": "playwright test --project=chromium tests/browser/smoke.spec.ts",
    "test:browser:smoke:firefox": "playwright test --project=firefox tests/browser/smoke.spec.ts",
    "test:browser:smoke:webkit": "playwright test --project=webkit tests/browser/smoke.spec.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "react": "~19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "~19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
