# ---------------------------------------------------------------------------
# Concord environment template (P7-M013 refresh).
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored
# and must NEVER be committed. This file contains NAMES and placeholders
# only — no real secrets.
#
# The executable contract is scripts/config/validate-env.mjs:
#   node scripts/config/validate-env.mjs --env-file .env.local --scope dev
# Full matrix (required/optional per scope, failure behavior):
#   docs/CONFIGURATION.md
# ---------------------------------------------------------------------------

# --- Web app (Next.js) — required in every scope ----------------------------
# PostgreSQL connection string (drizzle/pg pool).
DATABASE_URL=postgres://concord:concord_local_dev@localhost:5433/concord

# Isolated test database used by integration tests (never dev/prod data).
# Optional at runtime; required by `npm run db:migrate:test` and test suites.
DATABASE_TEST_URL=postgres://concord:concord_local_dev@localhost:5433/concord_test

# --- Clerk (identity) --------------------------------------------------------
# Publishable key is safe for the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only Clerk secret key. NEVER expose to the client bundle.
CLERK_SECRET_KEY=sk_test_replace_me

# --- Sync gateway (GATEWAY_*) — supplied by scripts/gateway-cluster.sh ------
# in local dev; a deployment supplies them via orchestrator env/secrets.
# Required (gateway exits 2 without them):
#   GATEWAY_DATABASE_URL   durable op-log Postgres URL
#   GATEWAY_CLERK_ISSUER   Clerk JWT issuer (must match the Clerk instance)
# GATEWAY_DATABASE_URL=postgres://concord:concord_local_dev@localhost:5433/concord
# GATEWAY_CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Required in container deployments (bind + browser origins):
#   GATEWAY_BIND_HOST=0.0.0.0        (IP literal only; 127.0.0.1 unreachable)
#   GATEWAY_ALLOWED_ORIGINS=https://your-app.example.com

# Distributed mode (staging/prod: set NATS; Redis optional but recommended):
#   GATEWAY_NATS_URL=nats://nats:4222
#   GATEWAY_REDIS_URL=redis://redis:6379
#   GATEWAY_NATS_SUBJECT_PREFIX=concord.dev   (ALL gateways must share it)

# Native maintenance worker (prod: required — snapshots/verify/compaction):
#   GATEWAY_WORKER_BINARY=/path/to/concord-worker
# (dev default: build/native/worker/concord-worker via the cmake flow)

# Optional knobs (defaults in docs/CONFIGURATION.md):
#   GATEWAY_BIND_PORT=8787
#   GATEWAY_MAX_FRAME_SIZE=8388608      (>= 1024)
#   GATEWAY_QUEUE_CAPACITY=512          (>= 1)
#   GATEWAY_HEARTBEAT_INTERVAL_SECS=30
#   GATEWAY_IDLE_TIMEOUT_SECS=120
#   GATEWAY_DB_POOL_SIZE=8
#   GATEWAY_ID=1                        (stable per-process identity)
#   GATEWAY_RATE_CONNECT_PER_MIN=240    (invalid values silently ignored)
#   GATEWAY_JWKS_FILE=                  (dev/E2E ONLY — never production)

# --- Observability (gateway, Phase 6) ---------------------------------------
#   GATEWAY_OTEL_ENABLED=false
#   GATEWAY_OTEL_ENDPOINT=http://127.0.0.1:4317
#   GATEWAY_OTEL_SAMPLE_RATIO=1.0       (must be within [0.0, 1.0])
#   GATEWAY_OTEL_EXPORTER=otlp          (otlp | stdout | memory)
#   GATEWAY_DEBUG_OP_IDS=false
#   RUST_LOG=info
